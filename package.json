{
  "name": "obsidian-git-gutter",
  "version": "0.2.0",
  "description": "Obsidian plugin that highlights uncommitted (added/modified) lines vs HEAD in the editor gutter.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/*.test.ts\"",
    "test:e2e": "node --test tests/e2e/*.e2e.mjs",
    "vault:install": "mkdir -p .obsidian/plugins/git-gutter && cp main.js manifest.json styles.css .obsidian/plugins/git-gutter/",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "git",
    "gutter",
    "diff"
  ],
  "author": "Dmitry Vorobyev",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.0.0",
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
